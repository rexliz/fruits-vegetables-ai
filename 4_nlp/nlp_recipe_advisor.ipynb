   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 🍎 Fruits & Vegetables AI – Block 4: NLP (Recipe & Health Advisor)\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Objective\\n\",\n",
    "    \"Use GPT-4o-mini to generate personalized recipe suggestions and health advice\\n\",\n",
    "    \"based on the CV classification result and ML-predicted nutritional values.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Integration\\n\",\n",
    "    \"- **Input from CV block:** detected food label (e.g. 'apple')\\n\",\n",
    "    \"- **Input from ML block:** predicted calories per 100g\\n\",\n",
    "    \"- **Output:** personalized recipe suggestion + health advice in English\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"from openai import OpenAI\\n\",\n",
    "    \"from dotenv import load_dotenv\\n\",\n",
    "    \"\\n\",\n",
    "    \"load_dotenv()\\n\",\n",
    "    \"client = OpenAI(api_key=os.environ.get('OPENAI_API_KEY'))\\n\",\n",
    "    \"print('✅ OpenAI client ready')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Prompt Design\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def generate_advice(food_label: str, calories: float, protein: float,\\n\",\n",
    "    \"                     fat: float, carbs: float, fiber: float) -> dict:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Generate health advice and recipe suggestion using GPT-4o-mini.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        food_label: detected food type from CV block\\n\",\n",
    "    \"        calories: predicted calories per 100g from ML block\\n\",\n",
    "    \"        protein, fat, carbs, fiber: macronutrients per 100g\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        dict with 'health_advice' and 'recipe_suggestion'\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    prompt = f\\\"\\\"\\\"You are a professional nutritionist and chef.\\n\",\n",
    "    \"\\n\",\n",
    "    \"A user has uploaded an image and the AI system detected: **{food_label}**\\n\",\n",
    "    \"\\n\",\n",
    "    \"Nutritional values per 100g (predicted by ML model):\\n\",\n",
    "    \"- Calories: {calories} kcal\\n\",\n",
    "    \"- Protein: {protein}g\\n\",\n",
    "    \"- Fat: {fat}g\\n\",\n",
    "    \"- Carbohydrates: {carbs}g\\n\",\n",
    "    \"- Fiber: {fiber}g\\n\",\n",
    "    \"\\n\",\n",
    "    \"Please provide:\\n\",\n",
    "    \"1. **Health Benefits** (2-3 sentences about why this food is good for you)\\n\",\n",
    "    \"2. **Best Recipe** (1 simple recipe using this ingredient, max 5 steps)\\n\",\n",
    "    \"3. **Serving Tip** (1 short tip on how to best enjoy it)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Keep it friendly, concise and practical.\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    response = client.chat.completions.create(\\n\",\n",
    "    \"        model='gpt-4o-mini',\\n\",\n",
    "    \"        messages=[{'role': 'user', 'content': prompt}],\\n\",\n",
    "    \"        max_tokens=400,\\n\",\n",
    "    \"        temperature=0.7\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return response.choices[0].message.content\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('✅ generate_advice() function ready')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Prompt Comparison (Iteration 1 vs 2)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Iteration 1: Simple prompt\\n\",\n",
    "    \"def generate_advice_simple(food_label: str, calories: float) -> str:\\n\",\n",
    "    \"    prompt = f'Give me a recipe for {food_label} which has {calories} calories per 100g.'\\n\",\n",
    "    \"    response = client.chat.completions.create(\\n\",\n",
    "    \"        model='gpt-4o-mini',\\n\",\n",
    "    \"        messages=[{'role': 'user', 'content': prompt}],\\n\",\n",
    "    \"        max_tokens=200\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return response.choices[0].message.content\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Test both prompts with apple\\n\",\n",
    "    \"print('=== Iteration 1: Simple Prompt ===')\\n\",\n",
    "    \"result_simple = generate_advice_simple('apple', 52)\\n\",\n",
    "    \"print(result_simple)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('\\\\n=== Iteration 2: Structured Prompt ===')\\n\",\n",
    "    \"result_structured = generate_advice('apple', 52, 0.3, 0.2, 14.0, 2.4)\\n\",\n",
    "    \"print(result_structured)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Test with more examples\\n\",\n",
    "    \"test_cases = [\\n\",\n",
    "    \"    {'food': 'broccoli', 'calories': 34, 'protein': 2.8, 'fat': 0.4, 'carbs': 7.0, 'fiber': 2.6},\\n\",\n",
    "    \"    {'food': 'banana',   'calories': 89, 'protein': 1.1, 'fat': 0.3, 'carbs': 23.0, 'fiber': 2.6},\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"for tc in test_cases:\\n\",\n",
    "    \"    print(f'\\\\n{'='*50}')\\n\",\n",
    "    \"    print(f'Food: {tc[\\\"food\\\"]} ({tc[\\\"calories\\\"]} kcal/100g)')\\n\",\n",
    "    \"    print('='*50)\\n\",\n",
    "    \"    result = generate_advice(tc['food'], tc['calories'], tc['protein'],\\n\",\n",
    "    \"                              tc['fat'], tc['carbs'], tc['fiber'])\\n\",\n",
    "    \"    print(result)\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
