   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 🍎 Fruits & Vegetables AI – Block 1: Exploratory Data Analysis\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Objective\\n\",\n",
    "    \"Explore the USDA nutrition dataset and prepare a clean version for the ML model.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Dataset\\n\",\n",
    "    \"- **Source:** USDA Nutritional Data\\n\",\n",
    "    \"- **File:** `data/nutrition.csv`\\n\",\n",
    "    \"- **Rows:** ~335 food items\\n\",\n",
    "    \"- **Columns:** Food, Measure, Grams, Calories, Protein, Fat, Sat.Fat, Fiber, Carbs, Category\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.read_csv('../data/nutrition.csv')\\n\",\n",
    "    \"print(f'Shape: {df.shape}')\\n\",\n",
    "    \"print(f'Columns: {list(df.columns)}')\\n\",\n",
    "    \"df.head(10)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Data Overview\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print('=== Data Types ===')\\n\",\n",
    "    \"print(df.dtypes)\\n\",\n",
    "    \"print('\\\\n=== Missing Values ===')\\n\",\n",
    "    \"print(df.isnull().sum())\\n\",\n",
    "    \"print('\\\\n=== Categories ===')\\n\",\n",
    "    \"print(df['Category'].value_counts())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Data Cleaning\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"df_clean = df.copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Replace trace values 't' with 0\\n\",\n",
    "    \"for col in ['Protein', 'Fat', 'Sat.Fat', 'Fiber', 'Carbs']:\\n\",\n",
    "    \"    df_clean[col] = df_clean[col].replace('t', '0')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Remove commas from numbers and convert to float\\n\",\n",
    "    \"for col in ['Grams', 'Calories', 'Protein', 'Fat', 'Sat.Fat', 'Fiber', 'Carbs']:\\n\",\n",
    "    \"    df_clean[col] = df_clean[col].astype(str).str.replace(',', '').str.strip()\\n\",\n",
    "    \"    df_clean[col] = pd.to_numeric(df_clean[col], errors='coerce')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Drop rows with missing critical values\\n\",\n",
    "    \"df_clean = df_clean.dropna(subset=['Grams', 'Calories', 'Protein', 'Fat', 'Carbs'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Remove rows where Grams = 0 to avoid division by zero\\n\",\n",
    "    \"df_clean = df_clean[df_clean['Grams'] > 0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'After cleaning: {df_clean.shape}')\\n\",\n",
    "    \"df_clean.head()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Normalize to per 100g\\n\",\n",
    "    \"df_clean['calories_per_100g'] = (df_clean['Calories'] / df_clean['Grams'] * 100).round(2)\\n\",\n",
    "    \"df_clean['protein_per_100g'] = (df_clean['Protein'] / df_clean['Grams'] * 100).round(2)\\n\",\n",
    "    \"df_clean['fat_per_100g'] = (df_clean['Fat'] / df_clean['Grams'] * 100).round(2)\\n\",\n",
    "    \"df_clean['carbs_per_100g'] = (df_clean['Carbs'] / df_clean['Grams'] * 100).round(2)\\n\",\n",
    "    \"df_clean['fiber_per_100g'] = (df_clean['Fiber'] / df_clean['Grams'] * 100).round(2)\\n\",\n",
    "    \"df_clean['satfat_per_100g'] = (df_clean['Sat.Fat'] / df_clean['Grams'] * 100).round(2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Encode category\\n\",\n",
    "    \"df_clean['category_encoded'] = df_clean['Category'].astype('category').cat.codes\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Final shape: {df_clean.shape}')\\n\",\n",
    "    \"df_clean[['Food', 'Category', 'calories_per_100g', 'protein_per_100g', 'fat_per_100g', 'carbs_per_100g', 'fiber_per_100g']].head(10)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Exploratory Visualizations\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].hist(df_clean['calories_per_100g'], bins=30, color='steelblue', edgecolor='white')\\n\",\n",
    "    \"axes[0].set_title('Distribution of Calories per 100g')\\n\",\n",
    "    \"axes[0].set_xlabel('Calories (kcal/100g)')\\n\",\n",
    "    \"axes[0].set_ylabel('Count')\\n\",\n",
    "    \"\\n\",\n",
    "    \"top_cats = df_clean.groupby('Category')['calories_per_100g'].median().sort_values(ascending=False).head(10)\\n\",\n",
    "    \"top_cats.plot(kind='barh', ax=axes[1], color='coral')\\n\",\n",
    "    \"axes[1].set_title('Median Calories per 100g by Category (Top 10)')\\n\",\n",
    "    \"axes[1].set_xlabel('Calories (kcal/100g)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../data/eda_calories_distribution.png', dpi=100)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print('✅ Plot saved')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"numeric_cols = ['calories_per_100g', 'protein_per_100g', 'fat_per_100g',\\n\",\n",
    "    \"                'carbs_per_100g', 'fiber_per_100g']\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(8, 6))\\n\",\n",
    "    \"corr = df_clean[numeric_cols].corr()\\n\",\n",
    "    \"sns.heatmap(corr, annot=True, fmt='.2f', cmap='coolwarm', ax=ax,\\n\",\n",
    "    \"            square=True, linewidths=0.5)\\n\",\n",
    "    \"ax.set_title('Correlation Matrix – Macronutrients')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../data/eda_correlation.png', dpi=100)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print('✅ Correlation heatmap saved')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(15, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ax, macro in zip(axes, ['fat_per_100g', 'carbs_per_100g', 'protein_per_100g']):\\n\",\n",
    "    \"    ax.scatter(df_clean[macro], df_clean['calories_per_100g'],\\n\",\n",
    "    \"               alpha=0.5, color='steelblue', s=30)\\n\",\n",
    "    \"    ax.set_xlabel(macro.replace('_per_100g', ' (g/100g)').capitalize())\\n\",\n",
    "    \"    ax.set_ylabel('Calories (kcal/100g)')\\n\",\n",
    "    \"    ax.set_title(f'{macro.split(\\\"_\\\")[0].capitalize()} vs Calories')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('Macronutrients vs Calories per 100g', fontsize=14)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../data/eda_scatter.png', dpi=100)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print('✅ Scatter plots saved')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Summary Statistics\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print('=== Summary Statistics (per 100g) ===')\\n\",\n",
    "    \"print(df_clean[numeric_cols].describe().round(2))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Save Clean Dataset\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"final_cols = [\\n\",\n",
    "    \"    'Food', 'Category', 'Grams', 'Calories',\\n\",\n",
    "    \"    'calories_per_100g', 'protein_per_100g', 'fat_per_100g',\\n\",\n",
    "    \"    'carbs_per_100g', 'fiber_per_100g', 'satfat_per_100g',\\n\",\n",
    "    \"    'category_encoded'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"final_cols = [c for c in final_cols if c in df_clean.columns]\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_save = df_clean[final_cols].reset_index(drop=True)\\n\",\n",
    "    \"df_save.to_csv('../data/nutrition_clean.csv', index=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'✅ nutrition_clean.csv saved with {len(df_save)} rows and {len(final_cols)} columns')\\n\",\n",
    "    \"print(f'Columns: {list(df_save.columns)}')\\n\",\n",
    "    \"df_save.head()\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
