   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 🍎 Fruits & Vegetables AI – Block 3: Computer Vision (CLIP Classification)\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Objective\\n\",\n",
    "    \"Use CLIP (Zero-Shot) to classify fruits and vegetables from images.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Integration\\n\",\n",
    "    \"- **Output to ML block:** detected food type → look up typical macronutrients → predict calories\\n\",\n",
    "    \"- **Output to NLP block:** food label → generate recipe suggestions\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from transformers import pipeline\\n\",\n",
    "    \"from PIL import Image\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import requests\\n\",\n",
    "    \"from io import BytesIO\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load CLIP model\\n\",\n",
    "    \"print('Loading CLIP model...')\\n\",\n",
    "    \"clip_classifier = pipeline(\\n\",\n",
    "    \"    model='openai/clip-vit-base-patch32',\\n\",\n",
    "    \"    task='zero-shot-image-classification'\\n\",\n",
    "    \")\\n\",\n",
    "    \"print('✅ CLIP loaded!')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Define Labels\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"FRUIT_LABELS = [\\n\",\n",
    "    \"    'apple', 'banana', 'orange', 'strawberry', 'grape', 'watermelon',\\n\",\n",
    "    \"    'pineapple', 'mango', 'peach', 'pear', 'cherry', 'lemon'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"VEGETABLE_LABELS = [\\n\",\n",
    "    \"    'carrot', 'broccoli', 'tomato', 'cucumber', 'pepper', 'spinach',\\n\",\n",
    "    \"    'potato', 'onion', 'garlic', 'lettuce', 'corn', 'mushroom'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"ALL_LABELS = FRUIT_LABELS + VEGETABLE_LABELS\\n\",\n",
    "    \"print(f'Total labels: {len(ALL_LABELS)}')\\n\",\n",
    "    \"print('Fruits:', FRUIT_LABELS)\\n\",\n",
    "    \"print('Vegetables:', VEGETABLE_LABELS)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Classification Function\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def classify_food(image_path_or_url):\\n\",\n",
    "    \"    \\\"\\\"\\\"Classify a fruit or vegetable from an image using CLIP Zero-Shot.\\\"\\\"\\\"\\n\",\n",
    "    \"    if str(image_path_or_url).startswith('http'):\\n\",\n",
    "    \"        response = requests.get(image_path_or_url)\\n\",\n",
    "    \"        image = Image.open(BytesIO(response.content)).convert('RGB')\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        image = Image.open(image_path_or_url).convert('RGB')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    results = clip_classifier(image, candidate_labels=ALL_LABELS)\\n\",\n",
    "    \"    top3 = results[:3]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'top_label': top3[0]['label'],\\n\",\n",
    "    \"        'top_score': round(top3[0]['score'], 4),\\n\",\n",
    "    \"        'top3': top3,\\n\",\n",
    "    \"        'is_fruit': top3[0]['label'] in FRUIT_LABELS\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('✅ classify_food() function ready')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Test with Example Images\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Test images (public domain)\\n\",\n",
    "    \"test_images = {\\n\",\n",
    "    \"    'apple': 'https://upload.wikimedia.org/wikipedia/commons/thumb/1/15/Red_Apple.jpg/600px-Red_Apple.jpg',\\n\",\n",
    "    \"    'banana': 'https://upload.wikimedia.org/wikipedia/commons/thumb/8/8a/Banana-Fruit-Bundle.jpg/640px-Banana-Fruit-Bundle.jpg',\\n\",\n",
    "    \"    'carrot': 'https://upload.wikimedia.org/wikipedia/commons/thumb/a/a2/Vegetable-Carrot-Bundle-wStem.jpg/640px-Vegetable-Carrot-Bundle-wStem.jpg',\\n\",\n",
    "    \"    'broccoli': 'https://upload.wikimedia.org/wikipedia/commons/thumb/0/03/Broccoli_and_cross_section_edit.jpg/640px-Broccoli_and_cross_section_edit.jpg'\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 4, figsize=(16, 4))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for idx, (true_label, url) in enumerate(test_images.items()):\\n\",\n",
    "    \"    response = requests.get(url)\\n\",\n",
    "    \"    img = Image.open(BytesIO(response.content)).convert('RGB')\\n\",\n",
    "    \"    result = classify_food(url)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    axes[idx].imshow(img)\\n\",\n",
    "    \"    color = 'green' if result['top_label'] == true_label else 'red'\\n\",\n",
    "    \"    axes[idx].set_title(\\n\",\n",
    "    \"        f'True: {true_label}\\\\nPred: {result[\\\"top_label\\\"]}\\\\n({result[\\\"top_score\\\"]*100:.1f}%)',\\n\",\n",
    "    \"        color=color, fontsize=10\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    axes[idx].axis('off')\\n\",\n",
    "    \"    print(f'{true_label}: predicted={result[\\\"top_label\\\"]} ({result[\\\"top_score\\\"]*100:.1f}%)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('CLIP Zero-Shot Classification Results', fontsize=14)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../data/cv_results.png', dpi=100)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Nutrition Lookup (CV → ML Bridge)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Typical macronutrients per 100g for our labels\\n\",\n",
    "    \"# Used to feed into the ML model after CV classification\\n\",\n",
    "    \"NUTRITION_LOOKUP = {\\n\",\n",
    "    \"    'apple':       {'protein': 0.3, 'fat': 0.2, 'carbs': 14.0, 'fiber': 2.4},\\n\",\n",
    "    \"    'banana':      {'protein': 1.1, 'fat': 0.3, 'carbs': 23.0, 'fiber': 2.6},\\n\",\n",
    "    \"    'orange':      {'protein': 0.9, 'fat': 0.1, 'carbs': 12.0, 'fiber': 2.4},\\n\",\n",
    "    \"    'strawberry':  {'protein': 0.7, 'fat': 0.3, 'carbs': 8.0,  'fiber': 2.0},\\n\",\n",
    "    \"    'grape':       {'protein': 0.6, 'fat': 0.2, 'carbs': 18.0, 'fiber': 0.9},\\n\",\n",
    "    \"    'watermelon':  {'protein': 0.6, 'fat': 0.2, 'carbs': 8.0,  'fiber': 0.4},\\n\",\n",
    "    \"    'pineapple':   {'protein': 0.5, 'fat': 0.1, 'carbs': 13.0, 'fiber': 1.4},\\n\",\n",
    "    \"    'mango':       {'protein': 0.8, 'fat': 0.4, 'carbs': 15.0, 'fiber': 1.6},\\n\",\n",
    "    \"    'peach':       {'protein': 0.9, 'fat': 0.3, 'carbs': 10.0, 'fiber': 1.5},\\n\",\n",
    "    \"    'pear':        {'protein': 0.4, 'fat': 0.1, 'carbs': 15.0, 'fiber': 3.1},\\n\",\n",
    "    \"    'cherry':      {'protein': 1.0, 'fat': 0.3, 'carbs': 16.0, 'fiber': 2.1},\\n\",\n",
    "    \"    'lemon':       {'protein': 1.1, 'fat': 0.3, 'carbs': 9.0,  'fiber': 2.8},\\n\",\n",
    "    \"    'carrot':      {'protein': 0.9, 'fat': 0.2, 'carbs': 10.0, 'fiber': 2.8},\\n\",\n",
    "    \"    'broccoli':    {'protein': 2.8, 'fat': 0.4, 'carbs': 7.0,  'fiber': 2.6},\\n\",\n",
    "    \"    'tomato':      {'protein': 0.9, 'fat': 0.2, 'carbs': 3.9,  'fiber': 1.2},\\n\",\n",
    "    \"    'cucumber':    {'protein': 0.7, 'fat': 0.1, 'carbs': 3.6,  'fiber': 0.5},\\n\",\n",
    "    \"    'pepper':      {'protein': 1.0, 'fat': 0.3, 'carbs': 6.0,  'fiber': 2.1},\\n\",\n",
    "    \"    'spinach':     {'protein': 2.9, 'fat': 0.4, 'carbs': 3.6,  'fiber': 2.2},\\n\",\n",
    "    \"    'potato':      {'protein': 2.0, 'fat': 0.1, 'carbs': 17.0, 'fiber': 2.2},\\n\",\n",
    "    \"    'onion':       {'protein': 1.1, 'fat': 0.1, 'carbs': 9.3,  'fiber': 1.7},\\n\",\n",
    "    \"    'garlic':      {'protein': 6.4, 'fat': 0.5, 'carbs': 33.0, 'fiber': 2.1},\\n\",\n",
    "    \"    'lettuce':     {'protein': 1.4, 'fat': 0.2, 'carbs': 2.9,  'fiber': 1.3},\\n\",\n",
    "    \"    'corn':        {'protein': 3.3, 'fat': 1.5, 'carbs': 19.0, 'fiber': 2.7},\\n\",\n",
    "    \"    'mushroom':    {'protein': 3.1, 'fat': 0.3, 'carbs': 3.3,  'fiber': 1.0},\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Test lookup\\n\",\n",
    "    \"food = 'apple'\\n\",\n",
    "    \"print(f'Nutrition for {food}: {NUTRITION_LOOKUP[food]}')\\n\",\n",
    "    \"print('\\\\n✅ NUTRITION_LOOKUP ready – bridge between CV and ML block')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Save lookup for use in app\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"with open('../data/nutrition_lookup.json', 'w') as f:\\n\",\n",
    "    \"    json.dump(NUTRITION_LOOKUP, f, indent=2)\\n\",\n",
    "    \"print('✅ nutrition_lookup.json saved')\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
